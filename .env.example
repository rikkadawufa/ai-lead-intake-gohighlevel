# Copy this file to .env and fill values locally. Do not commit .env.
# GoHighLevel: the sub-account's Private Integration Token and its Location ID.
GHL_TOKEN=
GHL_LOCATION_ID=
# Leave empty for the real API. For a mock run before the trial: http://mock:5690 (both lines).
GHL_BASE_URL=
META_GRAPH_URL=
# Meta app (development mode) and the test Page's lead form.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
# Short-lived user token from Graph API Explorer; `python scripts/meta_setup.py token` turns it into META_PAGE_TOKEN.
META_USER_TOKEN=
META_PAGE_TOKEN=
META_FORM_ID=
# Any random string; Meta sends it back when it subscribes the webhook.
META_VERIFY_TOKEN=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SLACK_WEBHOOK_URL=
# Login for the review page and its form (basic auth). Pick a long random password; reviewers share it.
REVIEW_USER=
REVIEW_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MODE=
# Demo only: approved replies go to this inbox instead of the made-up customer address.
DEMO_MODE=
REPLY_REDIRECT_TO=
GENERIC_TIMEZONE=
N8N_VERSION=
N8N_ENCRYPTION_KEY=
